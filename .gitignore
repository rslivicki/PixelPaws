/pawcapture/dist/
/pawcapture/installer_output/
/pawcapture/build_log.txt

# ── Example project shipped with the app: clips + key only, no outputs ──────
# (the user runs pose tracking and the classifiers on it themselves)
!example_project/
!example_project/videos/
!example_project/videos/*.mp4
!example_project/PixelPaws_project.json
# ...and never its run outputs (the release build zips untracked, non-ignored
# files too, so a test run inside the repo would otherwise ship)
example_project/videos/raw/
example_project/videos/*.h5
example_project/videos/*.pickle
example_project/features/
example_project/results/
example_project/paw_contour/
example_project/gait_limb_analysis/
